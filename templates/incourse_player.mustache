{{!
    @template mod_clearlesson/incourse_player

    Moodle template for the list of valid options in an autocomplate form element.
}}
<div class="mod-clearlesson">
    <div class="page-content-wrapper incourse incourse-player px-4" data-resourceref="{{resourceref}}"
    data-type={{type}} data-watchedall="{{watchedall}}" data-noseek="{{disableforwardseek}}" data-progress="{{progress}}">
        <div class="container-fluid">
            <div class="d-flex player-row{{#isvideo}} justify-content-center video{{/isvideo}} flex-wrap">
                {{^isvideo}}
                    <div class="video-list-column flex-shrink-0"{{#playlistref}} data-playlist="{{playlistref}}"{{/playlistref}}
                    {{#speakeref}} data-speaker="{{speakeref}}"{{/speakeref}} style="width: 16.666667%;">
                        <div class="box pe-0">
                            <h6 class="card-subtitle ps-2 mb-2 text-muted mt-2">
                                {{#topicref}}
                                    {{#str}} topicvideos, mod_clearlesson {{/str}}
                                {{/topicref}}
                                {{#playlistref}}
                                    {{#str}} playlistvideos, mod_clearlesson {{/str}}
                                {{/playlistref}}
                                {{#speakeref}}
                                    {{#str}} speakervideos, mod_clearlesson {{/str}}
                                {{/speakeref}}
                            </h6>
                            <hr class="mb-3">
                            {{#othervideos}}
                                {{> mod_clearlesson/elements/othervideo_card}}
                            {{/othervideos}}
                        </div>
                    </div>
                {{/isvideo}}
                <div class="player-column flex-grow-1" data-thumb="{{largethumbnail}}">
                    <div class="box p-0 d-flex flex-column justify-content-between w-100">
                        {{> mod_clearlesson/elements/video_iframe}}
                        <div class="p-2 speakerinfo d-flex bd-highlight mb-1 w-100">
                            <div class="me-auto bd-highlight d-flex justify-content-start">
                                <div class="d-flex bd-highlight">
                                    <div class="me-auto bd-highlight">
                                        <img class="speaker-img" alt="speaker" src="{{speakerimgsrc}}">
                                    </div>
                                    <div class="me-auto p-2 bd-highlight">
                                        <span href="javascript:void(0)" class="speaker-link text-muted" data-speakers="{{speakeref}}">{{speakername}}</span>
                                    </div>
                                </div>
                            </div>
                            {{> mod_clearlesson/elements/icons/watched_check}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>