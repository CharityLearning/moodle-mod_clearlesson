{{!
    @template mod_clearlesson/video_iframe

    Moodle template for the list of valid options in an autocomplate form element.
}}
<div class="mod-clearlesson">
    <div class="video-container" data-externalref="{{externalref}}">
        {{^resourceplayer}}
            {{> mod_clearlesson/elements/large_thumbnail}}
            {{> mod_clearlesson/elements/play_next_button }}
            {{> mod_clearlesson/elements/play_icon_div}}
        {{/resourceplayer}}
        <iframe class="videoframe" src="{{src}}&muted=1" title="{{name}}" frameborder="1" allowfullscreen data-duration="{{duration}}"
        allow="autoplay" {{^resourceplayer}}style="visibility:hidden"{{/resourceplayer}} aria-hidden="false"></iframe>
        {{#nextvideos}}
            <iframe aria-hidden="true" class="videoframe d-none" src="{{src}}&muted=1" title="{{name}}"
            data-duration="{{duration}}" frameborder="1" allowfullscreen allow="autoplay"></iframe>
        {{/nextvideos}}
        {{^inpage}}
            <script>
                require([{{#firstload}}'mod_clearlesson/vimeo-sdk', {{/firstload}}'mod_clearlesson/progress-tracker'],
                function({{#firstload}}VimeoPlayerConstructor, {{/firstload}}progressTracker) {
                    {{#firstload}}
                        window.VimeoPlayerConstructor = VimeoPlayerConstructor;
                    {{/firstload}}
                    // Here we initialise a new player for each video after destroying any previous instances.
                    {{^editform}}progressTracker.init();{{/editform}}
                });
            </script>
        {{/inpage}}
    </div>
    <div class="p-2 video-title-wrapper" style="position: relative">
        <h4 class="video-title ml-2">{{name}}</h4>
    </div>
</div>