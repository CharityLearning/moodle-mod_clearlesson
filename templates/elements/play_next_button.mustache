{{!
    @template mod_clearlesson/play_next_button

    Moodle template for the list of valid options in an autocomplate form element.
}}
{{^isvideo}}
    <div id="play-next-containter" class="w-100">
        {{^islast}}
            <button id="play-next-button" class="btn-primary loading {{^watched}} notwatched{{/watched}}"
            title="{{playnextstring}}" alt="{{playnextstring}}"  onclick="event.preventDefault();window.playNextItem()"
            {{^watched}}aria-hidden="true"{{/watched}}{{#watched}}aria-hidden="false"{{/watched}}>
                &nbsp&nbsp<i class="fas fa-play"></i>&nbsp&nbsp{{playnextstring}}&nbsp&nbsp&nbsp&nbsp
            </button>
        {{/islast}}
    </div>
{{/isvideo}}